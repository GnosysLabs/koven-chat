# Apex-domain Caddy block.  Appended to Caddyfile by `bin/koven setup`
# when SERVER_NAME differs from KOVEN_HOSTNAME (the standard "matrix
# server_name lives on the apex; client + Synapse on a subdomain"
# layout).  Serves the local-client well-known discovery file at the
# apex and redirects everything else to the app.
#
# Koven instances don't federate (see docs/GOVERNANCE.md), so the
# /.well-known/matrix/server and /.well-known/koven routes that used
# to live here are gone.  Only `matrix/client` remains — it's local-
# client discovery (lets a Matrix client typing "@user:{$SERVER_NAME}"
# resolve to the homeserver URL), not a federation handshake.

{$SERVER_NAME} {
	handle /.well-known/matrix/client {
		respond `{"m.homeserver": {"base_url": "https://{$KOVEN_HOSTNAME}"}}` 200
		header Content-Type application/json
		header Access-Control-Allow-Origin "*"
	}
	# Anything else — toss them at the actual app.
	redir / https://{$KOVEN_HOSTNAME}{uri} permanent
}
