# ── Secrets / per-install state ──────────────────────────────────────
# .env holds the install's auto-generated secrets (Postgres password,
# Synapse signing-related secrets, appservice tokens, TURN shared
# secret).  Never commit — leaking would let anyone impersonate the
# server.  Each operator generates their own via `bin/koven setup`.
.env
.env.local
.env.*.local
# Operator-side .env backups created during destructive operations
# (full reinstalls, prod migrations, .env rotations).  Useful for
# rollback locally; should never reach the repo since they contain
# the same secrets as `.env`.
.env.before-*
.env.pre-*

# ── Local-dev compose overrides ──────────────────────────────────────
# docker-compose.override.yml is auto-loaded alongside the main
# compose file — handy for dev (publish Synapse port to host, add
# host.docker.internal to Synapse's hosts table for native bun engine
# reach) but DESTRUCTIVE in prod (publishes ports that should stay
# internal, points appservice URLs at the wrong place).  Each operator
# writes their own from the example committed at the repo root if
# they want it.
docker-compose.override.yml

# Marketing site lives outside the product — each operator can put
# whatever HTML they want at their apex (or not).  The previous
# `marketing/` directory + `bin/deploy-marketing` rsync helper that
# pushed it to a specific VPS is gone from the repo; if a local
# `marketing/` tree exists, it's the operator's own.
/marketing/
/bin/deploy-marketing

# Synapse's per-install data: signing key (irreplaceable identity),
# database, uploaded media, rendered config.  All generated by setup
# or accumulated at runtime.
/synapse-data/

# Engine's per-install data: SQLite DB + uploaded branding assets.
/data/

# coturn config is rendered with the TURN shared secret in plain
# text — never commit.
/docker/coturn/turnserver.conf

# Caddyfile is rendered from Caddyfile.template into Caddyfile.runtime
# by `bin/koven setup`.  Repo ships the template; the runtime file
# is per-install (single-domain vs two-domain mode).
/Caddyfile.runtime

# nginx config (used when the host runs nginx instead of Caddy) is
# rendered from docker/nginx/koven.conf.template into
# docker/nginx/koven.conf by `bin/koven setup`.  Operators copy the
# rendered file into /etc/nginx/sites-available/.
/docker/nginx/koven.conf

# ── Build artifacts ──────────────────────────────────────────────────
node_modules/
**/node_modules/

dist/
build/
/client/dist/

# Bun + Vite caches
.bun-tag
.vite/
**/node_modules/.vite/

# TypeScript incremental build cache
*.tsbuildinfo

# Python bytecode (federation gate module)
__pycache__/
*.pyc
*.pyo

# ── OS / editor cruft ────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# ── Logs ─────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*

# ── Local SQLite (engine + legacy iris-web migration) ────────────────
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite-journal

# ── Docker volume mounts (shouldn't appear in repo, but defensive) ──
postgres_data/
caddy_data/
caddy_config/

# ── Misc ─────────────────────────────────────────────────────────────
/tmp/
/scratch/
# Local working agreements; never published.
CLAUDE.md

# Agent / Claude Code tooling, local to each operator.
.claude/
AGENTS.md

# Social-link icon source SVGs — inlined into SocialIcons.tsx at build,
# kept out of the repo as a local asset working set.
social-icons/
