# Koven install configuration.  Copy this to `.env` and fill in the
# top three variables.  Everything below the line is auto-generated
# by `bin/koven setup` if left blank — leave them blank on a fresh
# install.

# ─── Domain & TLS ────────────────────────────────────────────────────

# Where the web client + Matrix endpoints actually live.  This is the
# subdomain you want users to type into their browser.
KOVEN_HOSTNAME=client.koven.chat

# The Matrix server_name — what appears after the colon in user IDs.
# Convention is to use the apex domain for clean IDs (@alice:koven.chat).
# Requires you to point apex DNS at this VPS so we can serve
# /.well-known/matrix/* from there too.
#
# If you can't or don't want to use the apex, set this equal to
# KOVEN_HOSTNAME — user IDs become @alice:client.koven.chat, slightly
# less pretty, but no apex DNS needed.
SERVER_NAME=koven.chat

# Email for the instance's first admin.  Two roles:
#   1. Let's Encrypt account registration + cert renewal notifications.
#   2. The admin's sign-in address — `bin/koven bootstrap-admin` binds
#      this email to the @koven-admin Matrix user so you can sign in
#      to Koven web via the email-code flow as the instance admin.
# Required.  Must be a real address you can receive mail at.
ADMIN_EMAIL=admin@example.com

# ─── Email-code auth (passwordless sign-in) ──────────────────────────
# Pick ONE transport.  Resend takes precedence if both are configured.

# Option A: Resend (https://resend.com) — single HTTP API key.
RESEND_API_KEY=

# Option B: Generic SMTP — works with any provider (Postmark, SendGrid,
# Mailgun, Amazon SES, your own Postfix box).  All four host/port/
# user/password vars must be set together.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# "true" for implicit TLS (port 465); leave blank or "false" for
# STARTTLS (port 587).
SMTP_SECURE=false

# Sender address shown to recipients.  Must be on a domain you've
# verified with the chosen provider.
EMAIL_FROM="Koven <noreply@koven.chat>"

# Code lifetime in milliseconds.  Default 10 minutes.
EMAIL_CODE_TTL_MS=600000

# ─── Synapse admin user (auto-provisioned) ───────────────────────────
# The engine creates accounts and mints login tokens via Synapse's
# admin API, which requires a real admin user's access token (not
# the appservice as_token).  `bin/koven bootstrap-admin` provisions
# the admin user, binds ADMIN_EMAIL to it, and writes these three
# values back here.  Leave blank on first install.
SYNAPSE_ADMIN_USER=
SYNAPSE_ADMIN_PASSWORD=
SYNAPSE_ADMIN_TOKEN=

# ─── Optional: nginx-fronted deploys ─────────────────────────────────
# If your host already runs nginx + certbot for other services and
# you want them to terminate TLS for Koven too, set COMPOSE_FILE so
# every `docker compose` call merges in docker-compose.nginx.yml
# (which disables Caddy and binds Synapse + engine to 127.0.0.1).
# Then install docker/nginx/koven.conf (rendered by `bin/koven
# setup`) into /etc/nginx/sites-available/ and run
# `certbot --nginx -d $KOVEN_HOSTNAME -d $SERVER_NAME`.
# Leave blank if you're using the bundled Caddy.
#COMPOSE_FILE=docker-compose.yml:docker-compose.nginx.yml

# ─── Auto-generated below.  Leave blank on first install. ────────────
# `bin/koven setup` fills any empty value with a fresh random secret
# (32 bytes of urandom, hex-encoded) and writes it back here.  Once
# generated they should NOT change — Synapse and Postgres tie data
# integrity to these values.

POSTGRES_PASSWORD=
SYNAPSE_REGISTRATION_SHARED_SECRET=
SYNAPSE_MACAROON_SECRET_KEY=
SYNAPSE_FORM_SECRET=
ENGINE_AS_TOKEN=
ENGINE_HS_TOKEN=
TURN_SHARED_SECRET=
# AES-256-GCM key (32 bytes / 64 hex) for at-rest encryption of
# per-bot LLM API keys + Synapse access tokens.  Rotating breaks
# every existing bot config; regenerate only on fresh install.
BOT_KEY_ENCRYPTION_SECRET=
