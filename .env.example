# Koven install configuration.  Copy this to `.env` and adjust if
# needed.  The defaults below are tuned for **local development** —
# they boot a working stack on your laptop with zero edits.
#
# >>> Going to PRODUCTION? <<<
#   Change the three fields in the "Domain & TLS" section to your
#   real domain + admin email.  Everything else stays as-is unless
#   you've got specific reasons.
#
# Auto-generated secrets (Postgres password, AS tokens, etc.) are
# left blank — `bin/koven setup` fills them on first run.

# ─── Domain & TLS ────────────────────────────────────────────────────

# Where the web client + Matrix endpoints actually live.
#   Local dev: localhost (or your Tailscale IP if you want to hit it
#              from your phone — e.g. 100.76.239.128).
#   Prod:      the subdomain users type into their browser, e.g.
#              client.koven.example.
KOVEN_HOSTNAME=localhost

# The Matrix server_name — what appears after the colon in user IDs.
#   Local dev: same as KOVEN_HOSTNAME (no DNS, no .well-known to serve).
#   Prod:      conventionally the apex domain so IDs are clean
#              (@alice:koven.example).  Requires apex DNS pointed at
#              this VPS so /.well-known/matrix/* can be served from it.
#              If you can't or don't want apex DNS, set this equal to
#              KOVEN_HOSTNAME — IDs become @alice:client.koven.example,
#              slightly less pretty but no apex DNS needed.
SERVER_NAME=localhost

# Email for the instance's first admin.  Two roles:
#   1. Let's Encrypt account registration + cert renewal (prod only).
#   2. Sign-in address — `bin/koven bootstrap-admin` creates a
#      separate operator user and binds this email to it, so you can
#      sign in to Koven web via the email-code flow.
# REQUIRED.  Local dev: your real email so you actually get the codes
# (assuming RESEND_API_KEY or SMTP_* below is configured).  Prod: an
# address you check.  Leaving the example default disables operator
# account creation and skips Let's Encrypt notifications.
ADMIN_EMAIL=admin@example.com

# Optional: localpart for the operator's Matrix account.  Defaults to
# "admin" (so your MXID is @admin:<server>) — generic and predictable.
# Override if you want something else: "owner", your real handle, etc.
# Must be [a-z0-9-]{1,21}; uppercase / dots / plus-addressing aren't
# allowed by Matrix.  Cannot collide with the engine service account
# (@koven-svc by default).
#ADMIN_LOCALPART=admin

# ─── Email-code auth (passwordless sign-in) ──────────────────────────
# Pick ONE transport.  Resend takes precedence if both are configured.

# Option A: Resend (https://resend.com) — single HTTP API key.
RESEND_API_KEY=

# Option B: Generic SMTP — works with any provider (Postmark, SendGrid,
# Mailgun, Amazon SES, your own Postfix box).  All four host/port/
# user/password vars must be set together.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# "true" for implicit TLS (port 465); leave blank or "false" for
# STARTTLS (port 587).
SMTP_SECURE=false

# Sender address shown to recipients.  Must be on a domain you've
# verified with the chosen provider.
#   Local dev: anything on a domain you can mail FROM via your
#              transport (e.g. a verified Resend domain).  The
#              recipient is your real ADMIN_EMAIL.
#   Prod:      "Koven <noreply@your-domain.example>".
EMAIL_FROM="Koven Dev <dev@example.invalid>"

# Code lifetime in milliseconds.  Default 10 minutes.
EMAIL_CODE_TTL_MS=600000

# ─── Synapse admin user (auto-provisioned) ───────────────────────────
# The engine creates accounts and mints login tokens via Synapse's
# admin API, which requires a real admin user's access token (not
# the appservice as_token).  `bin/koven bootstrap-admin` provisions
# @koven-svc (a dedicated engine service account, NOT bound to any
# email) and writes the three values back here.  Leave blank on
# first install.
#
# Older installs may have these set to a `koven-admin` user that
# doubled as both engine service account AND operator — see
# `bin/koven migrate-prod-svc-account` for splitting them on a
# running stack without losing the operator's history.
SYNAPSE_ADMIN_USER=
SYNAPSE_ADMIN_PASSWORD=
SYNAPSE_ADMIN_TOKEN=

# Mirror of SERVER_NAME consumed by the engine's config loader.
# `bin/koven setup` keeps these in sync.  In prod compose, the engine
# container is fed HOMESERVER_NAME=${SERVER_NAME} via docker-compose.yml
# so this line is only load-bearing for the native bun dev workflow.
HOMESERVER_NAME=localhost

# Path to the appservice YAML the engine reads tokens from.  Compose
# mounts ./synapse-data into the engine container at /synapse-data,
# but native bun running on the host needs an absolute path.  Leave
# blank in prod — config.ts has a sensible default.
#ENGINE_REGISTRATION=

# ─── Optional: nginx-fronted deploys ─────────────────────────────────
# If your host already runs nginx + certbot for other services and
# you want them to terminate TLS for Koven too, set COMPOSE_FILE so
# every `docker compose` call merges in docker-compose.nginx.yml
# (which disables Caddy and binds Synapse + engine to 127.0.0.1).
# Then install docker/nginx/koven.conf (rendered by `bin/koven
# setup`) into /etc/nginx/sites-available/ and run
# `certbot --nginx -d $KOVEN_HOSTNAME -d $SERVER_NAME`.
# Leave blank if you're using the bundled Caddy.
#COMPOSE_FILE=docker-compose.yml:docker-compose.nginx.yml

# ─── Auto-generated below.  Leave blank on first install. ────────────
# `bin/koven setup` fills any empty value with a fresh random secret
# (32 bytes of urandom, hex-encoded) and writes it back here.  Once
# generated they should NOT change — Synapse and Postgres tie data
# integrity to these values.

POSTGRES_PASSWORD=
SYNAPSE_REGISTRATION_SHARED_SECRET=
SYNAPSE_MACAROON_SECRET_KEY=
SYNAPSE_FORM_SECRET=
ENGINE_AS_TOKEN=
ENGINE_HS_TOKEN=
TURN_SHARED_SECRET=
# AES-256-GCM key (32 bytes / 64 hex) for at-rest encryption of
# per-bot LLM API keys + Synapse access tokens.  Rotating breaks
# every existing bot config; regenerate only on fresh install.
BOT_KEY_ENCRYPTION_SECRET=
