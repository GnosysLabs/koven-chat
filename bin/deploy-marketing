#!/usr/bin/env bash
#
# Deploy the marketing site (`marketing/`) to the koven.chat VPS.
#
# Source of truth lives in this repo, NOT on the server — that way
# accidental edits on the VPS get overwritten the next time anyone
# runs this script, instead of silently shadowing the canonical
# version.
#
# Usage:
#   ./bin/deploy-marketing             # rsync to default host
#   KOVEN_MARKETING_HOST=user@vps ./bin/deploy-marketing
#   ./bin/deploy-marketing --dry-run   # show what would change
#
# Requires:
#   * `rsync` on PATH (any modern macOS / Linux ships it).
#   * SSH access to the VPS as a user that can write to
#     `/var/www/koven.chat/`.  Defaults to root@100.99.59.98 — the
#     same host already used elsewhere in `bin/koven`.  Override
#     with `KOVEN_MARKETING_HOST` if that ever changes.
#
# What it does:
#   1. Verifies `marketing/` exists and looks well-formed.
#   2. rsyncs the directory to `/var/www/koven.chat/` with --delete,
#      so files removed from the repo also disappear from the VPS.
#   3. Prints the live URL so you can spot-check.
#
# What it does NOT do:
#   * Reload nginx / Caddy — the site is static, no reload needed.
#   * Touch DNS or TLS certs.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
SRC="$REPO_ROOT/marketing/"
HOST="${KOVEN_MARKETING_HOST:-root@100.99.59.98}"
DEST_PATH="/var/www/koven.chat/"
# Optional: explicit SSH identity.  Leave unset to let ssh pick from
# ~/.ssh/config / agent.  Useful when the deploy host doesn't have
# a config entry and the right key is one of the ~/.ssh/id_* files.
SSH_KEY="${KOVEN_MARKETING_SSH_KEY:-}"
DRY_RUN=0

for arg in "$@"; do
	case "$arg" in
		--dry-run|-n) DRY_RUN=1 ;;
		--help|-h)
			sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//'
			exit 0
			;;
		*)
			echo "unknown arg: $arg (use --help)" >&2
			exit 2
			;;
	esac
done

if [ ! -d "$SRC" ]; then
	echo "deploy-marketing: $SRC not found" >&2
	exit 1
fi
if [ ! -f "$SRC/index.html" ]; then
	echo "deploy-marketing: $SRC/index.html missing — did the repo state get clobbered?" >&2
	exit 1
fi

# Common rsync flags:
#   -a  archive (recursive, symlinks, perms, times)
#   -v  verbose so the user sees what's syncing
#   -z  compress over the wire
#   --delete  remove files on the dest that aren't in the source
#   --human-readable  size formatting
#   --progress  per-file progress
RSYNC_FLAGS=(-avz --delete --human-readable
	# README.md in marketing/ is developer docs, not part of the
	# served site.  Exclude it so /var/www/koven.chat/README.md
	# never exists.
	--exclude='README.md')
if [ -n "$SSH_KEY" ]; then
	RSYNC_FLAGS+=(-e "ssh -i $SSH_KEY -o StrictHostKeyChecking=accept-new")
fi
if [ "$DRY_RUN" = "1" ]; then
	RSYNC_FLAGS+=(--dry-run --itemize-changes)
	echo "deploy-marketing: dry run — no files will be modified"
fi

echo "deploy-marketing: $SRC  →  $HOST:$DEST_PATH"
rsync "${RSYNC_FLAGS[@]}" "$SRC" "$HOST:$DEST_PATH"

if [ "$DRY_RUN" = "1" ]; then
	echo "deploy-marketing: dry run complete — re-run without --dry-run to apply"
else
	echo "deploy-marketing: done.  Live at https://koven.chat/"
fi
