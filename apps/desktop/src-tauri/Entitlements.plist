<?xml version="1.0" encoding="UTF-8"?>
<!--
	macOS Hardened Runtime entitlements for Koven Desktop.

	macOS gates microphone, camera, and screen-capture access behind
	BOTH the Info.plist usage-description string AND the matching
	hardened-runtime entitlement.  Without the entitlement, even a
	notarized app with the description string still fails to acquire
	the device — getUserMedia() throws NotAllowedError immediately
	and the app NEVER appears in System Settings → Privacy & Security
	at all (because macOS treats it as "didn't ask, didn't get
	asked").  That's the symptom of "call ended immediately when
	they tried to pick up": the answering side couldn't grab its
	mic/camera, so the call setup aborted.

	Each entitlement is paired with a usage description in
	Info.macOS.plist (referenced from tauri.conf.json's
	bundle.macOS.infoPlist) — both must be present for the prompt to
	fire.

	JIT entitlement is required for the matrix-rust-sdk WASM bundle
	(WebAssembly.instantiate uses it).  Without it, the WASM crypto
	stack fails to initialize and the app can't sign in.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<!--
		Associated Domains — Universal Links for client.koven.chat.
		When Apple's launch services see this entitlement, they fetch
		https://client.koven.chat/.well-known/apple-app-site-association
		once at install and periodically thereafter; a match between
		the AppID in that file (4PDUNTF69S.chat.koven.desktop) and the
		entitled-domain here means clicks on
		https://client.koven.chat/invite/* and /r/* anywhere in the
		OS open Koven Desktop directly instead of going to a browser
		tab.  The applinks: prefix scopes the entitlement to Universal
		Links specifically (vs. shared web credentials, etc.).

		IMPORTANT: This entitlement requires the "Associated Domains"
		capability to be enabled on the App ID at developer.apple.com.
		The signing identity must be issued for an App ID that lists
		Associated Domains; otherwise codesign succeeds but Apple's
		runtime rejects the entitlement silently and Universal Links
		never fire (you'll just keep getting browser-tab routing).
	-->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:client.koven.chat</string>
	</array>
</dict>
</plist>
