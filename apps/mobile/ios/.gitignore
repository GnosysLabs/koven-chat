# Cordova plugins for Capacitor
capacitor-cordova-ios-plugins

# Generated Config files
App/App/capacitor.config.json
App/App/config.xml

# Podfile + Podfile.lock are regenerated by `cap sync` and are pure
# build output, not source.  Under bun the pod `:path =>` entries
# resolve to `node_modules/.bun/<pkg>@<version>+<hash>/...` realpaths,
# so the embedded hash churns on every install and both files show as
# modified after every sync.  The iOS build always runs `cap sync`
# first (`bun run sync`), so they never need to be committed.
App/Podfile
App/Podfile.lock
