# Caddy config for Koven.  Auto-rendered by `bin/koven setup` from
# this template into a real Caddyfile that compose mounts.  Two
# possible shapes:
#
#   1. SERVER_NAME == KOVEN_HOSTNAME (single-domain install):
#      Only the main site block runs.
#
#   2. SERVER_NAME != KOVEN_HOSTNAME (apex + subdomain):
#      Both blocks run.  Apex serves /.well-known/matrix/client only
#      so local Matrix-shaped clients can resolve `@user:apex` to the
#      subdomain homeserver; everything else redirects to the main
#      site.
#
# Koven instances don't federate (see docs/GOVERNANCE.md), so the
# /.well-known/matrix/server and /.well-known/koven routes that used
# to live here are gone.  The remaining `matrix/client` route is
# local-client discovery only — it lets a Matrix client typing
# "@user:apex" find the homeserver URL.
#
# Caddy fetches Let's Encrypt certs automatically for whichever
# domains are listed, given a reachable HTTP/HTTPS port and DNS A
# records pointing here.

{
	email {$ADMIN_EMAIL}
}

# ─── Main site: web client + matrix + engine ──────────────────────────
{$KOVEN_HOSTNAME} {
	# Client well-known — local Matrix clients use this after the user
	# types "@someone:{$KOVEN_HOSTNAME}".  Not a federation handshake.
	handle /.well-known/matrix/client {
		respond `{"m.homeserver": {"base_url": "https://{$KOVEN_HOSTNAME}"}}` 200
		header Content-Type application/json
		header Access-Control-Allow-Origin "*"
	}
	# Apple App-Site Association — Universal Links for the Koven
	# Desktop bundle.  When the OS sees the
	# com.apple.developer.associated-domains entitlement on Koven
	# (applinks:{$KOVEN_HOSTNAME}), it fetches this file once at
	# install + refreshes periodically.  A successful match means
	# any click on https://{$KOVEN_HOSTNAME}/invite/* or /r/* in
	# Mail / Messages / Safari etc. opens Koven Desktop directly
	# instead of routing through a browser tab.  AppIDs format is
	# <TeamID>.<bundleId>; paths are glob-matched against the URL
	# path.  The file MUST be served as application/json with no
	# .json extension on the URL path itself.  See:
	# https://developer.apple.com/documentation/xcode/supporting-associated-domains
	handle /.well-known/apple-app-site-association {
		respond `{"applinks":{"details":[{"appIDs":["4PDUNTF69S.chat.koven.desktop"],"components":[{"/":"/invite/*","comment":"Room and space invites"},{"/":"/r/*","comment":"Message permalinks"}]}]}}` 200
		header Content-Type application/json
	}

	# Engine API + uploads.  Order matters: more specific paths
	# before the SPA fallback below.
	handle /api/* {
		reverse_proxy engine:9000
	}
	handle /static/* {
		reverse_proxy engine:9000
	}

	# Synapse — client-server API only.  No federation traffic
	# (homeserver.yaml drops the federation listener name and no
	# /.well-known/matrix/server route exists, so remote Matrix
	# servers can't discover us in the first place).
	handle /_matrix/* {
		reverse_proxy synapse:8008
	}
	handle /_synapse/* {
		reverse_proxy synapse:8008
	}

	# Web client SPA.  Build output mounted at /srv/client; all
	# non-API/non-matrix routes fall through to index.html so the
	# client-side router handles them.
	handle {
		root * /srv/client
		try_files {path} /index.html
		file_server
	}

	encode gzip
	log {
		output stdout
		format console
	}
}
